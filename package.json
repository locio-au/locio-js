{
  "name": "@locio-au/client",
  "version": "0.1.0",
  "description": "Australian address autocomplete, validation and geocoding against G-NAF, for Node, Bun, Deno, workers and the browser.",
  "keywords": [
    "address autocomplete",
    "address validation",
    "australian address lookup",
    "address geocoding",
    "g-naf",
    "gnaf api",
    "address api",
    "mesh block",
    "australia post address",
    "typescript",
    "australia"
  ],
  "license": "MIT",
  "homepage": "https://locio.com.au",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locio-au/locio-js.git"
  },
  "bugs": {
    "url": "https://github.com/locio-au/locio-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
